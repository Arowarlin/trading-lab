# Copia este archivo a .env y rellena lo que tengas.
# Nunca subas .env a git.

# --- Broker (Alpaca PAPER) ---
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Datos ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_USER_AGENT=TradingLab/0.1 (tu-email@example.com)

# --- LLM local (LM Studio) ---
LAB_LLM_BASE_URL=http://127.0.0.1:1234/v1
# MoE 30B-A3B: ~16x mas rapido en CPU que el 27B denso.
LAB_LLM_MODEL=qwen/qwen3-30b-a3b
# qwen3 razona antes de responder y esos tokens cuentan en el limite.
# Por debajo de ~1024 el content vuelve vacio (finish_reason=length).
# LAB_LLM_MAX_TOKENS=4096

# --- Lado deep (TradingAgents): opcional, proveedor de nube ---
# Si estas variables existen, el deep las usa y el lite sigue en LM Studio.
# Cualquier endpoint OpenAI-compatible sirve (gateway de OpenCode, DeepSeek...).
# Con suscripcion Go de OpenCode el endpoint es /inference/go/openai/v1;
# sin Go (saldo) es /inference/openai/v1. El de /inference/v1 solo lista modelos.
# LAB_DEEP_LLM_PROVIDER=openai_compatible
# LAB_DEEP_LLM_MODEL=deepseek-v4.1-flash
# LAB_DEEP_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LAB_DEEP_MAX_TOKENS=8192
# LAB_DEEP_LLM_API_KEY=

# --- TradingAgents / Trading-R1 ---
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://127.0.0.1:1234/v1
TRADINGAGENTS_QUICK_THINK_LLM=qwen3.8-27b
TRADINGAGENTS_DEEP_THINK_LLM=qwen3.8-27b
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_NO_UPDATE_CHECK=1

TR1_VLLM_BASE_URL=http://127.0.0.1:1234/v1
TR1_VLLM_MODEL=qwen3.8-27b

# --- Futuros: ProjectX / TopstepX ---
# Genera la API key en el dashboard de TopstepX. Empieza con cuenta simulada.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=
PROJECTX_REQUIRE_SIMULATED=1

# --- Notificaciones (opcional) ---
# Propuesta: ntfy (sin bot). Crea un topic privado y ponlo en NTFY_TOPIC.
ALERTS_ENABLED=1
ALERT_CHANNEL=ntfy
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
ALERT_COOLDOWN_S=300
HEALTHCHECKS_URL=
# Telegram remoto: preferido keyring (`lab telegram setup`). Esto es solo fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
