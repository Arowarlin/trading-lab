# Copia este archivo a .env y rellena lo que tengas.
# Nunca subas .env a git.

# --- Broker (Alpaca PAPER) ---
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Datos ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- LLM local (LM Studio) ---
LAB_LLM_BASE_URL=http://127.0.0.1:1234/v1
LAB_LLM_MODEL=qwen3.8-27b

# --- TradingAgents / Trading-R1 ---
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://127.0.0.1:1234/v1
TRADINGAGENTS_QUICK_THINK_LLM=qwen3.8-27b
TRADINGAGENTS_DEEP_THINK_LLM=qwen3.8-27b
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_NO_UPDATE_CHECK=1

TR1_VLLM_BASE_URL=http://127.0.0.1:1234/v1
TR1_VLLM_MODEL=qwen3.8-27b

# --- Futuros: ProjectX / TopstepX ---
# Genera la API key en el dashboard de TopstepX. Empieza con cuenta simulada.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=
PROJECTX_REQUIRE_SIMULATED=1

# --- Notificaciones (opcional) ---
# Propuesta: ntfy (sin bot). Crea un topic privado y ponlo en NTFY_TOPIC.
ALERTS_ENABLED=1
ALERT_CHANNEL=ntfy
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
ALERT_COOLDOWN_S=300
HEALTHCHECKS_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
